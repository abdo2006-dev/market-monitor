# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://market:market@localhost:5432/market_monitor

# ─── Cache / Queue ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ─── Locale ──────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD

# ─── Scraping ────────────────────────────────────────────────────────────────
# Browser user-agent sent with every request
USER_AGENT=MarketMonitor/1.0 (price monitoring bot; contact your@email.com)

# Run Playwright in headless mode (true recommended for servers)
PLAYWRIGHT_HEADLESS=true

# Durable Sync V2 (PostgreSQL is the queue/source of truth)
SYNC_EXECUTION_MODE=v2
SYNC_MAX_ATTEMPTS=3
SYNC_LEASE_SECONDS=600
# Keep false through single-competitor and manual Sync-All proof. GitHub uses
# a repository Actions variable with the same name to gate its schedules separately.
SYNC_MORNING_ENABLED=false
# Set to github_actions only on the server after configuring the three values below.
SYNC_DISPATCH_PROVIDER=none
# GITHUB_ACTIONS_DISPATCH_TOKEN=server-only fine-grained token; this repository, Actions: write
# GITHUB_ACTIONS_REPOSITORY=owner/repository
# GITHUB_ACTIONS_WORKFLOW=sync-v2.yml
# GITHUB_ACTIONS_REF=main

# ─── Discord ─────────────────────────────────────────────────────────────────
# Master on/off switch for all Discord notifications
DISCORD_NOTIFICATIONS_ENABLED=true

# Per-competitor webhooks are set inside the competitor record.
# You can also set a global fallback webhook here if desired.
# DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/...
